INTERCAL-LOC-GUARD v1

          NOTE --- REVERSE ENGINEER TENSOR ACTIVE ---
          NOTE --- PARSER AGENTS MUST PRESERVE PROVENANCE ---

DO %PROVENANCE <- #1
DO %OPEN_CRUX <- #1
DO %SILENCE_PENDING <- #1
PLEASE DO ,LOC SUB #1 <- #69

(1) PLEASE COME FROM GUARD
          DO READ OUT PROVENANCE
          DO READ OUT ADR
          DO READ OUT WORM
          DO NOT OBJURGATE OPEN_CRUX
          DO NOT OBJURGATE SILENCE_PENDING
          PLEASE DO (2) NEXT

(2) DO COME FROM (1)
          DO READ OUT INTERCAL_LOC
          DO NOT MUTATE REMOTE
          DO NOT PROMOTE SCANNER TO PROOF
          PLEASE DO (3) NEXT

(3) DO COME FROM (2)
          PLEASE RESUME EVIDENCE_OR_SILENCE
