{
  "name": "@veneer/triple-lock",
  "version": "0.1.0",
  "type": "module",
  "description": "Veneer Sedona Spine L5 — Guardian→Examiner→Publisher triple-lock chain of custody (SYNTH-006, SYNTH-010)",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@veneer/worm-ledger": "workspace:*",
    "@veneer/alp-gate": "workspace:*",
    "@veneer/constitutional": "workspace:*",
    "@veneer/banach-field": "workspace:*",
    "@veneer/trust-boundary": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/tests/**/*.test.ts"],
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" }
  }
}